@*

*@

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Borderô</title>
    <meta name="robots" content="noindex, follow">

    <style type="text/css">
        body {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        table, th, td {
            border-collapse: collapse;
            font-size: 14px;
        }

        .text-center {
            text-align: center !important;
        }

        .text-right {
            text-align: right !important;
        }

        .bold {
            font-weight: bolder;
        }

        .border {
            border: 3px black solid;
        }

        .watermar {
            position: absolute;
            top: 4%;
            left: 45%;
            opacity: 0.25;
            display: none;
            width: 12%;
        }

        .watermark {
            top: 4%;
            margin-left: 480px;
            opacity: 0.25;
            display: none;
            width: 12%;
        }

        .noBorder {
            border: 0 !important;
        }

        @@media print {
            .watermark {
                display: block !important;
            }

            .pagebreak {
                page-break-before: always;
            }

            input {
                border: 0;
                outline: 0;
                font-weight: bold;
            }

            @@page {
                size: landscape
            }
        }
    </style>
</head>
<body height: 1000px;">
    @{
        decimal totalCreditoGerenteGestor = 0;
        decimal totalComissaoGerenteGestor = 0;
        decimal totalCredito = 0;
        decimal totalComissao = 0;

        if (Model.User.Profile == "GERENTE")
        {
            <img class="watermark" src="data:image/png;base64," />
            <div class="text-center" style="margin-right: 10px; margin-left: 10px; margin-top: 10px;">
                <h3 class="bold">RELATORIO SEMANAL DE COMISSÕES - CONSIL</h3>
            </div>
            <div class="row" style="width: 100%;">
                <div class="text-center" style="width: 50%; float: left">
                    <h4 class="bold">MASTER: @Model.User.Representation</h4>
                </div>
                <div class="text-center" style="width: 50%; float: left">
                    <h4 class="bold">PERÍODO @Model.StartDate.ToString().Split(" ")[0] À @Model.EndDate.ToString().Split(" ")[0]</h4>
                </div>
            </div>

            <div style="margin-right: 10px; margin-left: 10px">
                <table style="width: 100%;" class="border">
                    <thead style="color:white; background-color: rgb(76, 76, 76);">
                        <tr>
                            <th class="text-center">Contrato</th>
                            <th class="text-center">Bem</th>
                            <th class="text-center">Data da Venda</th>
                            <th class="text-center">Nome</th>
                            <th class="text-center">Crédito</th>
                            <th class="text-center">Tabela</th>
                            <th class="text-center">Comissão %</th>
                            <th class="text-center">Comissão R$</th>
                            <th class="text-center">Produto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Contracts)
                        {
                            totalCreditoGerenteGestor += Convert.ToDecimal(item.Proposal.CreditValue);
                            totalComissaoGerenteGestor += Convert.ToDecimal(item.Proposal.CreditValue) * Convert.ToDecimal(item.Proposal.TableTypeManager) / 100;

                            <tr>
                                <td class="text-center noBorder">@item.ContractNum</td>
                                <td class="text-center noBorder">@item.Proposal.ProductTypeName</td>
                                <td class="text-center noBorder">@item.DateAproved.ToString().Split(" ")[0]</td>
                                <td class="text-center noBorder">@item.Proposal.Client.Name</td>
                                <td class="text-center noBorder">@item.Proposal.CreditValue</td>
                                <td class="text-center noBorder">@item.Proposal.TableTypeTax</td>
                                <td class="text-center noBorder">@item.Proposal.TableTypeManager</td>
                                <td class="text-center noBorder">
                                    @(
                                    string.Format("{0:C}", Convert.ToDecimal(item.Proposal.CreditValue) * Convert.ToDecimal(item.Proposal.TableTypeManager) / 100)
                                        )
                                </td>
                                <td class="text-center noBorder">CONSULTORIA</td>
                            </tr>
                        }
                        <tr class="bold">
                            <td class="border" colspan="3"></td>
                            <td class="text-center border">Total/Base Credito:</td>
                            <td class="text-center border">@string.Format("{0:C}",totalCreditoGerenteGestor)</td>
                            <td class="text-center border" colspan="2">Total Comissão:</td>
                            <td class="text-center border">@string.Format("{0:C}",totalComissaoGerenteGestor)</td>
                            <td class="text-center border"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div style="margin-top: 30px;">
                <table style="width: 30%; margin: 0 auto;" class="border">
                    <thead style="border: 1px solid">
                        <tr>
                            <th colspan="2" class="text-center">Resumo da empresa comissionada</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Total de comissionamento</td>
                            <td class="text-right bold" style="color: green; border-left: 1px solid black">@string.Format("{0:C}",totalComissaoGerenteGestor)</td>
                        </tr>
                        <tr>
                            <td>Descontos</td>
                            <td class="text-right bold" style="color: red; border-left: 1px solid black"><input style="width: 100px; text-align: right; color:red;" class="desconto" value="R$ 0,00" /></td>
                        </tr>
                        <tr style="background-color: rgb(76, 76, 76)">
                            <td>&nbsp;</td>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td>Total de comissionamento</td>
                            <td class="text-right bold" style="color: green; border-left: 1px solid black"><input style="width: 100px; text-align: right; color:green;" class="total" value="@string.Format("{0:C}",totalComissaoGerenteGestor)" /></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="pagebreak"> </div>
        }
        else if (Model.User.Profile == "GESTOR")
        {
            <img class="watermark" src="data:image/png;base64," />
            <div class="text-center" style="margin-right: 10px; margin-left: 10px; margin-top: 10px;">
                <h3 class="bold">RELATORIO SEMANAL DE COMISSÕES - CONSIL</h3>
            </div>
            <div class="row" style="width: 100%;">
                <div class="text-center" style="width: 50%; float: left">
                    <h4 class="bold">GESTOR: @Model.User.Representation</h4>
                </div>
                <div class="text-center" style="width: 50%; float: left">
                    <h4 class="bold">PERÍODO @Model.StartDate.ToString().Split(" ")[0] À @Model.EndDate.ToString().Split(" ")[0]</h4>
                </div>
            </div>

            <div style="margin-right: 10px; margin-left: 10px">
                <table style="width: 100%;" class="border">
                    <thead style="color:white; background-color: rgb(76, 76, 76);">
                        <tr>
                            <th class="text-center">Contrato</th>
                            <th class="text-center">Bem</th>
                            <th class="text-center">Data da Venda</th>
                            <th class="text-center">Nome</th>
                            <th class="text-center">Crédito</th>
                            <th class="text-center">Tabela</th>
                            <th class="text-center">Comissão %</th>
                            <th class="text-center">Comissão R$</th>
                            <th class="text-center">Produto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Contracts)
                        {
                            totalCreditoGerenteGestor += Convert.ToDecimal(item.Proposal.CreditValue);
                            totalComissaoGerenteGestor += Convert.ToDecimal(item.Proposal.CreditValue) * Convert.ToDecimal(item.Proposal.TableTypeGestor) / 100;

                            <tr>
                                <td class="text-center noBorder">@item.ContractNum</td>
                                <td class="text-center noBorder">@item.Proposal.ProductTypeName</td>
                                <td class="text-center noBorder">@item.DateAproved.ToString().Split(" ")[0]</td>
                                <td class="text-center noBorder">@item.Proposal.Client.Name</td>
                                <td class="text-center noBorder">@item.Proposal.CreditValue</td>
                                <td class="text-center noBorder">@item.Proposal.TableTypeTax</td>
                                <td class="text-center noBorder">@item.Proposal.TableTypeGestor</td>
                                <td class="text-center noBorder">
                                    @(
                                    string.Format("{0:C}", Convert.ToDecimal(item.Proposal.CreditValue) * Convert.ToDecimal(item.Proposal.TableTypeGestor) / 100)
                                        )
                                </td>
                                <td class="text-center noBorder">CONSULTORIA</td>
                            </tr>
                        }
                        <tr class="bold">
                            <td class="border" colspan="3"></td>
                            <td class="text-center border">Total/Base Credito:</td>
                            <td class="text-center border">@string.Format("{0:C}", totalCreditoGerenteGestor)</td>
                            <td class="text-center border" colspan="2">Total Comissão:</td>
                            <td class="text-center border">@string.Format("{0:C}", totalComissaoGerenteGestor)</td>
                            <td class="text-center border"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div style="margin-top: 30px;">
                <table style="width: 30%; margin: 0 auto;" class="border">
                    <thead style="border: 1px solid">
                        <tr>
                            <th colspan="2" class="text-center">Resumo da empresa comissionada</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Total de comissionamento</td>
                            <td class="text-right bold" style="color: green; border-left: 1px solid black">@string.Format("{0:C}", totalComissaoGerenteGestor)</td>
                        </tr>
                        <tr>
                            <td>Descontos</td>
                            <td class="text-right bold" style="color: red; border-left: 1px solid black"><input style="width: 100px; text-align: right; color:red;" class="desconto" value="R$ 0,00" /></td>
                        </tr>
                        <tr style="background-color: rgb(76, 76, 76)">
                            <td>&nbsp;</td>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td>Total de comissionamento</td>
                            <td class="text-right bold" style="color: green; border-left: 1px solid black"><input style="width: 100px; text-align: right; color:green;" class="total" value="@string.Format("{0:C}",totalComissaoGerenteGestor)" /></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="pagebreak"> </div>
        }

        <img class="watermark" src="data:image/png;base64," />
        <div class="text-center" style="margin-right: 10px; margin-left: 10px; margin-top: 10px;">
            <h3 class="bold">RELATORIO SEMANAL DE COMISSÕES - CONSIL</h3>
        </div>
        <div class="row" style="width: 100%;">
            <div class="text-center" style="width: 50%; float: left">
                <h4 class="bold">REPRESENTANTE: @Model.User.Representation</h4>
            </div>
            <div class="text-center" style="width: 50%; float: left">
                <h4 class="bold">PERÍODO @Model.StartDate.ToString().Split(" ")[0] À @Model.EndDate.ToString().Split(" ")[0]</h4>
            </div>
        </div>
        <div style="margin-right: 10px; margin-left: 10px">
            <table style="width: 100%;" class="border">
                <thead style="color:white; background-color: rgb(76, 76, 76);">
                    <tr>
                        <th class="text-center">Contrato</th>
                        <th class="text-center">Bem</th>
                        <th class="text-center">Data da Venda</th>
                        <th class="text-center">Nome</th>
                        <th class="text-center">Crédito</th>
                        <th class="text-center">Tabela</th>
                        <th class="text-center">Comissão %</th>
                        <th class="text-center">Comissão R$</th>
                        <th class="text-center">Produto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Contracts)
                    {
                        if (item.Proposal.UserId == Model.User.Id)
                        {
                            totalCredito += Convert.ToDecimal(item.Proposal.CreditValue);
                            totalComissao += Convert.ToDecimal(item.Proposal.CreditValue) * Convert.ToDecimal(item.Proposal.TableTypeCommission) / 100;

                            <tr>
                                <td class="text-center noBorder">@item.ContractNum</td>
                                <td class="text-center noBorder">@item.Proposal.ProductTypeName</td>
                                <td class="text-center noBorder">@item.DateAproved.ToString().Split(" ")[0]</td>
                                <td class="text-center noBorder">@item.Proposal.Client.Name</td>
                                <td class="text-center noBorder">@item.Proposal.CreditValue</td>
                                <td class="text-center noBorder">@item.Proposal.TableTypeTax</td>
                                <td class="text-center noBorder">@item.Proposal.TableTypeCommission</td>
                                <td class="text-center noBorder">
                                    @(
                                    string.Format("{0:C}", Convert.ToDecimal(item.Proposal.CreditValue) * Convert.ToDecimal(item.Proposal.TableTypeCommission) / 100)
                                        )
                                </td>
                                <td class="text-center noBorder">CONSULTORIA</td>
                            </tr>
                        }
                    }
                    <tr class="bold">
                        <td class="border" colspan="3"></td>
                        <td class="text-center border">Total/Base Credito:</td>
                        <td class="text-center border">@string.Format("{0:C}",totalCredito)</td>
                        <td class="text-center border" colspan="2">Total Comissão:</td>
                        <td class="text-center border">@string.Format("{0:C}",totalComissao)</td>
                        <td class="text-center border"></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div style="margin-top: 30px;">
            <table style="width: 30%; margin: 0 auto;" class="border">
                <thead style="border: 1px solid">
                    <tr>
                        <th colspan="2" class="text-center">Resumo da empresa comissionada</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Total de comissionamento</td>
                        <td class="text-right bold" style="color: green; border-left: 1px solid black">@string.Format("{0:C}",totalComissao)</td>
                    </tr>
                    <tr>
                        <td>Descontos</td>
                        <td class="text-right bold" style="color: red; border-left: 1px solid black"><input style="width: 100px; text-align: right; color:red;" class="desconto" value="R$ 0,00" /></td>
                    </tr>
                    <tr style="background-color: rgb(76, 76, 76)">
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>Total de comissionamento</td>
                        <td class="text-right bold" style="color: green; border-left: 1px solid black"><input style="width: 100px; text-align: right; color:green;" class="total" value="@string.Format("{0:C}",totalComissao)" /></td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</body>
</html>

